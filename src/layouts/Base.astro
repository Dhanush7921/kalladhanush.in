---
import { url } from '../lib/url';
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/instrument-sans/wdth.css';
import '../styles/global.css';
import '../styles/cinematic.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChapterRail from '../components/ChapterRail.astro';
import { site, contact } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  intro?: boolean;
  chapters?: { id: string; label: string }[];
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og-image.jpg',
  intro = false,
  chapters = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.knownAs,
  url: new URL(url('/'), Astro.site).href,
  jobTitle: site.roles.join(', '),
  email: `mailto:${contact.email}`,
  address: { '@type': 'PostalAddress', addressLocality: site.location.city, addressCountry: 'IN' },
  sameAs: [contact.instagram, contact.github].filter(Boolean),
  image: ogImage,
};
---
<!doctype html>
<html lang="en-IN" data-intro={intro ? 'enabled' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="manifest" href={url('/site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <script is:inline>
      // Runs before paint: enables JS styling and decides whether the intro shows.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var opts = new URLSearchParams(location.search);
        if(opts.get('render') === 'static') d.dataset.render = 'static';
        if(opts.get('motion') === 'reduce') d.classList.add('motion-reduced');
        if (d.dataset.intro !== 'enabled') return;
        var seen = false;
        try { seen = localStorage.getItem('kd-intro-done') === '1'; } catch (e) {}
        var force = /[?&]intro=1\b/.test(location.search);
        if (!seen || force) d.classList.add('intro-pending');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <Header />
    <slot name="intro" />
    {chapters.length > 0 && <ChapterRail chapters={chapters} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div class="toast" role="status" aria-live="polite" hidden></div>
    <script>
      import { initUI } from '../scripts/ui';
      initUI();
      if(document.querySelector('[data-exhibit]')) {
        const io = new IntersectionObserver((entries) => { if(entries.some(e=>e.isIntersecting)) { io.disconnect(); import('../scripts/exhibits').then(m=>m.initExhibits()); } }, {rootMargin:'200px'});
        document.querySelectorAll('[data-exhibit]').forEach(e=>io.observe(e));
      }
    </script>
  </body>
</html>

<style is:global>
  .scroll-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 120;
    pointer-events: none;
  }
  .scroll-progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--metal);
    transform-origin: 0 50%;
    transform: scaleX(var(--progress, 0));
  }
  main:focus { outline: none; }
  .toast {
    position: fixed;
    left: 50%;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    z-index: 150;
    transform: translateX(-50%);
    padding: 0.85rem 1.3rem;
    max-width: min(92vw, 34rem);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(19 17 14 / 0.92);
    backdrop-filter: blur(10px);
    color: var(--ivory);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    text-align: center;
    box-shadow: 0 20px 50px -20px rgb(214 178 110 / 0.4);
  }
</style>


