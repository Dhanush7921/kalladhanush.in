---
import { url } from '../lib/url';
import { site, nav, contact, whatsappLink } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="sign-off">
      <p class="philosophy">
        {site.philosophy.map((line) => <span>{line}</span>)}
      </p>
      <a class="btn btn-gold" href={url('/contact/')}>Start a conversation</a>
    </div>

    <div class="grid">
      <div class="brand-block">
        <span class="mark gold-text" aria-hidden="true">D.</span>
        <p class="name">{site.nameUpper}</p>
        <p class="muted small">{site.title}</p>
        <p class="muted small">{site.location.city}, {site.location.country}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="links">
          <li><a href={url('/')}>Home</a></li>
          {nav.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
        </ul>
      </nav>
      <ul class="links contact">
        <li><a href={`mailto:${contact.email}`}>Email</a></li>
        <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href={contact.instagram} target="_blank" rel="noopener">Instagram</a></li>
        <li><a href={contact.github} target="_blank" rel="noopener">GitHub</a></li>
        <li><button type="button" class="linklike" data-replay-intro>Replay intro</button></li>
      </ul>
    </div>

    <div class="legal">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Built with Astro and Three.js. Map data: <a href="https://www.naturalearthdata.com/" target="_blank" rel="noopener">Natural Earth</a>.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    border-top: 1px solid var(--line);
    padding: clamp(4rem, 10vh, 7rem) 0 2rem;
    background:
      radial-gradient(60vmax 30vmax at 50% 0%, rgb(154 106 58 / 0.14), transparent 70%),
      var(--onyx);
  }
  .sign-off {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: clamp(3rem, 8vh, 5rem);
    border-bottom: 1px solid var(--line);
  }
  .philosophy {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1.05;
    font-variation-settings: 'opsz' 96;
  }
  .philosophy span { display: block; }
  .philosophy span:nth-child(2) { color: var(--ivory-dim); }
  .philosophy span:nth-child(3) { font-style: italic; color: var(--gold); }

  .grid {
    display: grid;
    gap: 2.5rem;
    padding-block: 3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) { .grid { grid-template-columns: 1.4fr 1fr 0.8fr; } }
  .mark { font-family: var(--font-display); font-weight: 700; font-size: 3rem; line-height: 1; font-variation-settings: 'opsz' 96; }
  .name { margin: 0.75rem 0 0.4rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.28em; }
  .small { font-size: 0.92rem; margin: 0 0 0.2rem; }
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; align-content: start; }
  nav .links { grid-template-columns: repeat(2, minmax(0, max-content)); column-gap: 2.5rem; }
  .links a, .linklike {
    display: inline-block;
    padding: 0.2rem 0;
    color: var(--ivory-dim);
    text-decoration: none;
    font: inherit;
    font-size: 0.95rem;
  }
  .links a:hover, .linklike:hover { color: var(--gold-bright); }
  .linklike { background: none; border: 0; cursor: pointer; text-align: left; }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--ivory-faint);
  }
  .legal p { margin: 0; }
</style>
