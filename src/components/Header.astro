---
import { url } from '../lib/url';
import { site, nav, contact, whatsappLink } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === url('/') : path.startsWith(url(href)));
const primary = nav.filter((n) => n.primary);
---
<header class="site-header" data-header>
  <div class="bar container">
    <a class="brand" href={url('/')} aria-label={`${site.name} — home`} data-monogram>
      <span class="brand-mark gold-text" aria-hidden="true">D.</span>
      <span class="brand-rule" aria-hidden="true"></span>
      <span class="brand-name">{site.nameUpper}</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {primary.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="bar-actions">
      <button class="icon-btn sound-toggle" type="button" data-sound-toggle aria-pressed="false" hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M4 10v4h3l4 3.5V6.5L7 10H4z" fill="currentColor" />
          <path class="wave" d="M15 9.2a4 4 0 0 1 0 5.6M17.6 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path class="mute" d="M15.5 9.5l5 5m0-5l-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <span class="visually-hidden">Ambient sound</span>
      </button>
      <button class="menu-btn" type="button" data-menu-open aria-haspopup="dialog" aria-controls="site-menu">
        <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
        <span class="menu-label">Menu</span>
      </button>
    </div>
  </div>
</header>

<dialog class="site-menu" id="site-menu" aria-label="Site menu" data-menu>
  <div class="menu-inner container">
    <div class="menu-top">
      <span class="brand-mark gold-text" aria-hidden="true">D.</span>
      <button class="menu-close" type="button" data-menu-close>
        Close <span aria-hidden="true" class="x">×</span>
      </button>
    </div>
    <nav aria-label="All pages" class="menu-nav">
      <ul>
        <li><a href={url('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Home</a></li>
        {nav.map((item) => (
          <li><a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="menu-foot">
      <p class="serif-note">{site.tagline}</p>
      <ul class="menu-contact">
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp {contact.whatsappDisplay}</a></li>
        <li><a href={contact.instagram} target="_blank" rel="noopener">Instagram</a></li>
      </ul>
      <button class="btn btn-small" type="button" data-replay-intro>Replay intro</button><a class="text-link" href={url("/?motion=reduce")}>Reduced motion</a><a class="text-link" href={url("/?render=static")}>Lightweight mode</a><a class="text-link" href={url("/")}>Full experience</a>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    transition: background-color 0.4s, border-color 0.4s, transform 0.5s var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  :global(.is-scrolled) .site-header {
    background: rgb(0 0 0 / 0.72);
    backdrop-filter: blur(14px) saturate(120%);
    border-bottom-color: var(--line);
  }
  :global(html.intro-pending) .site-header { transform: translateY(-110%); }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    min-height: 44px;
  }
  .brand-mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.85rem;
    line-height: 1;
    font-variation-settings: 'opsz' 96;
  }
  .brand-rule { width: 1px; height: 22px; background: var(--line-strong); }
  .brand-name {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    color: var(--ivory);
  }

  .primary-nav { display: none; }
  .primary-nav ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .primary-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.8rem;
    font-size: 0.92rem;
    color: var(--ivory-dim);
    text-decoration: none;
    position: relative;
    transition: color 0.25s;
  }
  .primary-nav a::after {
    content: '';
    position: absolute;
    left: 0.8rem; right: 0.8rem; bottom: 9px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.4s var(--ease-out);
  }
  .primary-nav a:hover, .primary-nav a[aria-current='page'] { color: var(--ivory); }
  .primary-nav a:hover::after, .primary-nav a[aria-current='page']::after { transform: scaleX(1); }
  @media (min-width: 1120px) { .primary-nav { display: block; } }

  .bar-actions { display: flex; align-items: center; gap: 0.5rem; }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ivory-dim);
    cursor: pointer;
  }
  .icon-btn:hover { color: var(--gold-bright); border-color: var(--line-strong); }
  .sound-toggle .wave { display: none; }
  .sound-toggle[aria-pressed='true'] .wave { display: inline; }
  .sound-toggle[aria-pressed='true'] .mute { display: none; }
  .sound-toggle[aria-pressed='true'] { color: var(--gold-bright); border-color: var(--line-strong); }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0 1rem 0 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ivory);
    font: 600 0.72rem/1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .menu-btn:hover { border-color: var(--gold); }
  .menu-lines { display: grid; gap: 5px; width: 18px; }
  .menu-lines span { height: 1px; background: var(--gold); }
  .menu-lines span:last-child { width: 12px; }

  /* Menu dialog */
  .site-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background:
      radial-gradient(80vmax 60vmax at 85% 10%, rgb(154 106 58 / 0.22), transparent 60%),
      #000;
    color: var(--ivory);
    overflow-y: auto;
  }
  .site-menu::backdrop { background: rgb(0 0 0 / 0.6); }
  .site-menu[open] { animation: menu-in 0.5s var(--ease-out); }
  @keyframes menu-in { from { opacity: 0; } to { opacity: 1; } }
  .menu-inner { min-height: 100%; display: flex; flex-direction: column; padding-block: 1.1rem 2.5rem; }
  .menu-top { display: flex; justify-content: space-between; align-items: center; min-height: 48px; }
  .menu-close {
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ivory);
    font: 600 0.72rem/1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .menu-close .x { font-size: 1.2rem; margin-left: 0.35rem; color: var(--gold); }
  .menu-nav { flex: 1; display: flex; align-items: center; padding-block: 2rem; }
  .menu-nav ul {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 0.2rem 3rem;
    width: 100%;
  }
  .menu-nav a {
    display: block;
    padding: 0.35rem 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem);
    line-height: 1.15;
    font-variation-settings: 'opsz' 96;
    text-decoration: none;
    color: var(--ivory);
    transition: color 0.25s, transform 0.4s var(--ease-out);
  }
  .menu-nav a:hover { color: var(--gold-bright); transform: translateX(0.4rem); }
  .menu-nav a[aria-current='page'] { color: var(--gold); font-style: italic; }
  .menu-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .menu-foot .serif-note { margin: 0; }
  .menu-contact { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .menu-contact a { color: var(--ivory-dim); font-size: 0.95rem; }

  @media (max-width: 520px) {
    .brand-name { font-size: 0.68rem; letter-spacing: 0.2em; }
    .brand-rule { display: none; }
    .menu-label { display: none; }
    .menu-btn { padding: 0 0.85rem; }
  }
</style>

