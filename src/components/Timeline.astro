---
import { url } from '../lib/url';
import type { JourneyEntry } from '../data/journey';
import { publishedProjects } from '../data/projects';
interface Props { entries: JourneyEntry[]; compact?: boolean }
const { entries, compact = false } = Astro.props;
const projectExists = (slug?: string) => !!slug && publishedProjects.some((p) => p.slug === slug);
---
<ol class:list={['timeline', { compact }]}>
  {entries.map((e, i) => (
    <li class="entry" data-kind={e.kind} data-reveal>
      <span class="node" aria-hidden="true"><span>{String(i + 1).padStart(2, '0')}</span></span>
      <details class="card" open={!compact && i === entries.length - 1}>
        <summary>
          <span class="kind">{e.kind}{e.when && <> <span class="when">{e.when}</span></>}</span>
          <span class="title">{e.title}</span>
          <span class="place">{e.place}</span>
          {e.result && <span class="result">{e.result}</span>}
          <span class="toggle" aria-hidden="true"></span>
        </summary>
        <div class="details">
          <p>{e.summary}</p>
          <ul>{e.details.map((d) => <li>{d}</li>)}</ul>
          {projectExists(e.projectSlug) && (
            <a class="text-link" href={url(`/projects/${e.projectSlug}/`)}>Open the project</a>
          )}
        </div>
      </details>
    </li>
  ))}
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: 1rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--gold) 8%, var(--bronze) 92%, transparent);
    opacity: 0.6;
  }
  .entry { position: relative; display: grid; grid-template-columns: 44px 1fr; gap: 1rem; align-items: start; }
  .node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px; height: 44px;
    margin-top: 0.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--onyx);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 0.04em;
  }
  .entry[data-kind='Experience'] .node { border-color: var(--ember); color: var(--ember); box-shadow: 0 0 18px rgb(226 129 60 / 0.35); }
  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: linear-gradient(180deg, rgb(28 25 20 / 0.7), rgb(19 17 14 / 0.6));
    transition: border-color 0.3s;
  }
  .card[open], .card:hover { border-color: var(--line-strong); }
  summary {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1.5rem;
    padding: 1.15rem 3.4rem 1.15rem 1.35rem;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-m);
  }
  summary::-webkit-details-marker { display: none; }
  .kind { grid-column: 1 / -1; font-size: 0.82rem; color: var(--ivory-dim); }
  .when { color: var(--gold); margin-left: 0.4rem; }
  .title { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.15; }
  .place { grid-column: 1; color: var(--ivory-dim); font-size: 0.95rem; }
  .result {
    grid-column: 2;
    grid-row: 2 / span 2;
    align-self: center;
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--gold-bright);
    white-space: nowrap;
  }
  .toggle {
    position: absolute;
    right: 1.2rem;
    top: 50%;
    width: 22px; height: 22px;
    margin-top: -11px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }
  .toggle::before, .toggle::after {
    content: '';
    position: absolute;
    left: 50%; top: 50%;
    width: 9px; height: 1px;
    background: var(--gold);
    transform: translate(-50%, -50%);
    transition: transform 0.35s var(--ease-out);
  }
  .toggle::after { transform: translate(-50%, -50%) rotate(90deg); }
  .card[open] .toggle::after { transform: translate(-50%, -50%) rotate(0deg); }
  .details { padding: 0 1.35rem 1.35rem; color: var(--ivory-dim); }
  .details ul { margin: 0 0 1rem; padding-left: 1.1rem; }
  .details li { margin-bottom: 0.35rem; }
  .details li::marker { color: var(--gold); }

  .compact .title { font-size: var(--step-1); }
  .compact .result { font-size: var(--step-1); }

  @media (max-width: 560px) {
    summary { grid-template-columns: 1fr; padding-right: 3rem; }
    .result { grid-column: 1; grid-row: auto; font-size: var(--step-1); }
    .entry { grid-template-columns: 36px 1fr; gap: 0.7rem; }
    .node { width: 36px; height: 36px; font-size: 0.66rem; }
    .timeline::before { left: 17px; }
  }
</style>

