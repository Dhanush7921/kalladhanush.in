---
import { publishedProjects } from '../data/projects';
import { url } from '../lib/url';
---
<div class="project-theatre" data-project-theatre>
  <div class="exhibit project-space" data-exhibit="projects" aria-label="Interactive project sculptures">
    <span class="scene-coordinate">COLLECTION / 01—03</span>
    <div class="exhibit-fallback" aria-hidden="true">D.</div>
    <span class="scene-caption">CONCEPTUAL OBJECTS · DRAG TO ROTATE</span>
  </div>
  <div class="project-console">
    <div class="project-select" role="tablist" aria-label="Choose a project">
      {publishedProjects.map((p,i)=><button type="button" role="tab" id={'project-tab-'+p.slug} aria-controls={'project-panel-'+p.slug} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-project-select={i}><span>0{i+1}</span>{p.title}</button>)}
    </div>
    {publishedProjects.map((p,i)=><article id={'project-panel-'+p.slug} role="tabpanel" aria-labelledby={'project-tab-'+p.slug} data-project-panel={i} hidden={i!==0}>
      <p class="eyebrow">{p.category} <span> / </span> {p.status}</p>
      <h3>{p.title}<span class="gold-text">.</span></h3>
      <p class="project-sub">{p.subtitle}</p><p>{p.summary}</p>
      <a class="btn btn-gold" href={url('/projects/'+p.slug+'/')}>Explore the case study ↗</a>
    </article>)}
  </div>
</div>
