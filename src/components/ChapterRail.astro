---
interface Props { chapters: { id: string; label: string }[] }
const { chapters } = Astro.props;
---
<nav class="chapter-rail" aria-label="Chapters on this page" data-chapter-rail>
  <ol>
    {chapters.map((c) => (
      <li>
        <a href={`#${c.id}`} data-chapter-link={c.id}>
          <span class="dot" aria-hidden="true"></span>
          <span class="label">{c.label}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .chapter-rail {
    position: fixed;
    right: clamp(0.6rem, 1.6vw, 1.6rem);
    top: 50%;
    z-index: 80;
    transform: translateY(-50%);
    display: none;
    transition: opacity 0.4s;
  }
  @media (min-width: 900px) { .chapter-rail { display: block; } }
  :global(html.intro-pending) .chapter-rail { opacity: 0; pointer-events: none; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  a {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: 0.75rem;
    min-height: 30px;
    padding: 0 0.25rem;
    text-decoration: none;
    color: var(--ivory-dim);
  }
  .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: background 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .label {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.3s, transform 0.3s var(--ease-out);
    white-space: nowrap;
    background: rgb(0 0 0 / 0.7);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }
  a:hover .label, a:focus-visible .label, a[aria-current='true'] .label { opacity: 1; transform: none; }
  a[aria-current='true'] { color: var(--gold-bright); }
  a[aria-current='true'] .dot { background: var(--gold); transform: scale(1.35); box-shadow: 0 0 12px var(--gold); border-color: var(--gold); }
  /* Labels only show for the active chapter unless hovered */
  .chapter-rail:not(:hover) a:not([aria-current='true']):not(:focus-visible) .label { opacity: 0; }
</style>
