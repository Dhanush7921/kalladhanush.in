---
import { contact, mailtoLink, whatsappLink } from '../data/site';
const intents = [
  { id: 'employment', label: 'Employment', subject: 'Employment opportunity', prompt: 'Tell me about the role and team.' },
  { id: 'collaboration', label: 'Collaboration', subject: 'Collaboration idea', prompt: 'What would you like to build together?' },
  { id: 'creative', label: 'Creative partnership', subject: 'Creative partnership', prompt: 'Photography, video or a creative project in mind?' },
  { id: 'general', label: 'General message', subject: 'Hello from kalladhanush.in', prompt: 'Say hello.' },
];
---
<div class="hub panel" data-contact-hub>
  <fieldset class="intents">
    <legend>What is this about?</legend>
    <div class="intent-grid">
      {intents.map((it, i) => (
        <label class="intent">
          <input type="radio" name="intent" value={it.id} data-subject={it.subject} data-prompt={it.prompt} checked={i === 0} />
          <span>{it.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="fields">
    <label>
      <span>Your name <em>(optional)</em></span>
      <input type="text" name="name" autocomplete="name" data-name />
    </label>
    <label>
      <span>Message <em>(optional)</em></span>
      <textarea name="message" rows="4" data-message placeholder={intents[0].prompt}></textarea>
    </label>
  </div>

  <div class="actions">
    <a class="btn btn-gold" data-send-email href={mailtoLink(intents[0].subject)}>Email Dhanush</a>
    <a class="btn" data-send-whatsapp href={whatsappLink(`Hi Dhanush — ${intents[0].subject}.`)} target="_blank" rel="noopener">Message on WhatsApp</a>
  </div>
  <p class="note">Opens your email app or WhatsApp with the message ready to send. Nothing is stored on this site.</p>
  <p class="direct">
    Or write directly to <a href={`mailto:${contact.email}`}>{contact.email}</a>
  </p>
</div>

<style>
  .hub { padding: clamp(1.25rem, 4vw, 2.25rem); display: grid; gap: 1.5rem; }
  fieldset { border: 0; margin: 0; padding: 0; }
  legend { font-family: var(--font-display); font-size: var(--step-2); margin-bottom: 1rem; padding: 0; }
  .intent-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 0.6rem; }
  .intent { position: relative; }
  .intent input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .intent span {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    font-size: 0.98rem;
    transition: border-color 0.3s, background 0.3s, color 0.3s;
  }
  .intent span::before {
    content: '';
    width: 12px; height: 12px;
    margin-right: 0.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    flex: none;
  }
  .intent input:checked + span { border-color: var(--gold); background: rgb(214 178 110 / 0.08); color: var(--gold-bright); }
  .intent input:checked + span::before { background: var(--gold); box-shadow: 0 0 10px var(--gold); border-color: var(--gold); }
  .intent input:focus-visible + span { outline: 2px solid var(--ember); outline-offset: 3px; }
  .intent:hover span { border-color: var(--line-strong); }
  .fields { display: grid; gap: 1rem; }
  .fields label { display: grid; gap: 0.45rem; }
  .fields span { font-size: 0.9rem; color: var(--ivory-dim); }
  .fields em { font-style: normal; color: var(--ivory-faint); }
  input[type='text'], textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgb(0 0 0 / 0.45);
    color: var(--ivory);
    font: inherit;
    font-size: 1rem;
    resize: vertical;
  }
  input[type='text']:focus, textarea:focus { border-color: var(--gold); outline: none; box-shadow: 0 0 0 3px rgb(214 178 110 / 0.18); }
  textarea::placeholder { color: var(--ivory-faint); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .note, .direct { margin: 0; font-size: 0.88rem; color: var(--ivory-faint); }
  .direct a { color: var(--ivory-dim); }
</style>

<script>
  import { mailtoLink, whatsappLink } from '../data/site';
  document.querySelectorAll<HTMLElement>('[data-contact-hub]').forEach((hub) => {
    const email = hub.querySelector<HTMLAnchorElement>('[data-send-email]')!;
    const wa = hub.querySelector<HTMLAnchorElement>('[data-send-whatsapp]')!;
    const name = hub.querySelector<HTMLInputElement>('[data-name]')!;
    const msg = hub.querySelector<HTMLTextAreaElement>('[data-message]')!;
    const update = () => {
      const intent = hub.querySelector<HTMLInputElement>('input[name="intent"]:checked')!;
      const subject = intent.dataset.subject!;
      msg.placeholder = intent.dataset.prompt!;
      const who = name.value.trim();
      const body = [msg.value.trim(), who ? `— ${who}` : ''].filter(Boolean).join('\n\n');
      email.href = mailtoLink(subject, body || undefined);
      wa.href = whatsappLink(`Hi Dhanush — ${subject}.${body ? `\n\n${body}` : ''}`);
    };
    hub.addEventListener('input', update);
    hub.addEventListener('change', update);
    update();
  });
</script>
