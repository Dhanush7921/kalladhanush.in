---
import { Picture } from 'astro:assets';
import { site } from '../data/site';
import { photos } from '../data/gallery';
---
<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="stage" data-globe-host data-globe aria-hidden="true"><canvas class="stage-canvas" data-globe-canvas></canvas><div class="stage-fallback"><span class="fallback-orbit"></span></div></div>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-inner container">
    <div class="hero-copy">
      <p class="eyebrow" data-hero-step="1"><span class="live-dot"></span> ENGINEERING × IMAGINATION</p>
      <h1 id="hero-title" tabindex="-1" data-hero-step="2">Kalla<br/><span class="gold-text">Dhanush.</span></h1>
      <p class="hero-roles" data-hero-step="3">{site.title}</p>
      <p class="hero-tagline" data-hero-step="4">Beyond Vision.<br/><em>Into Reality.</em></p>
      <p class="hero-intro" data-hero-step="4">I am Dhanush — a technology-driven innovator, developer and ambitious entrepreneur passionate about turning ideas into reality.</p>
      <div class="hero-ctas" data-hero-step="5"><a class="btn btn-gold" href="#about">Explore my world <span>↗</span></a><a class="text-link" href="#work">Discover my work</a></div>
    </div>
    <figure class="hero-portrait" data-hero-step="portrait">
      <div class="portrait-halo" aria-hidden="true"></div>
      <Picture src={photos.heroStudioBikeCutout} alt="Kalla Dhanush seated on his motorcycle in the original studio photograph." widths={[480,700,857]} sizes="(min-width: 900px) 49vw, 90vw" formats={['avif','webp']} loading="eager" fetchpriority="high"/>
      <figcaption><span>THE PERSON. THE PURPOSE.</span><em>One vision. Many dimensions.</em></figcaption>
    </figure>
  </div>
  <div class="hero-bottom container"><a href="#about">↓ &nbsp; SCROLL TO EXPLORE</a><span>VISAKHAPATNAM, INDIA · 17.6868° N</span><button type="button" data-replay-intro>↺ REPLAY INTRO</button></div>
</section>
<style>
.hero{position:relative;min-height:max(100svh,820px);isolation:isolate;overflow:hidden;background:radial-gradient(ellipse at 80% 48%,#26190970,transparent 55%),#050505}
.stage{position:absolute;inset:0;z-index:1;pointer-events:none}.stage-canvas{width:100%;height:100%;opacity:0;transition:opacity 1s}.stage-ready .stage-canvas{opacity:1}
:global(html.intro-pending) .stage{position:fixed;z-index:105;background:#030303;inset:0;height:100svh}
.stage-fallback{display:none}.webgl-failed .stage-fallback,:global(.no-webgl) .stage-fallback{display:block}.fallback-orbit{position:absolute;right:4%;top:10%;width:50%;aspect-ratio:1;border:1px solid #bd8a4b;border-radius:50%;box-shadow:0 0 70px #b26f2930,inset 0 0 70px #b26f2930}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(#b88b4710 1px,transparent 1px),linear-gradient(90deg,#b88b4710 1px,transparent 1px);background-size:100px 100px;mask-image:linear-gradient(transparent,black);transform:perspective(600px) rotateX(64deg) scale(1.5);transform-origin:bottom;opacity:.5}
.hero-inner{position:relative;z-index:2;display:grid;grid-template-columns:1.1fr 1fr;align-items:center;min-height:max(100svh,820px);padding-top:100px;padding-bottom:110px;pointer-events:none}
.hero-copy{z-index:3;position:relative;max-width:640px}.hero-copy a{pointer-events:auto}.eyebrow{font-size:.68rem;letter-spacing:.24em;color:var(--gold);display:flex;align-items:center;gap:12px;margin-bottom:28px}.live-dot{width:5px;height:5px;border-radius:50%;background:#f4c87c;box-shadow:0 0 12px #d3a456}
h1{font-size:clamp(5rem,7.5vw,8.7rem);line-height:.87;letter-spacing:-.055em;margin-bottom:28px}h1 span{padding-right:.12em}.hero-roles{font-size:.77rem;letter-spacing:.045em;color:#e0d6c6}.hero-tagline{font-size:clamp(1.9rem,2.9vw,3.4rem);font-family:var(--font-display);line-height:1.13;margin:25px 0 20px}.hero-tagline em{color:var(--gold)}.hero-intro{font-size:.96rem;line-height:1.75;color:var(--ivory-dim);max-width:43ch}.hero-ctas{display:flex;gap:25px;align-items:center;margin-top:30px}.hero-ctas .btn{gap:22px}
.hero-portrait{margin:0;position:absolute;right:-1%;bottom:50px;height:85%;width:auto;aspect-ratio:857/1270;max-width:60%;z-index:1}.hero-portrait :global(picture){display:block;width:100%;height:100%;mask-image:linear-gradient(to top,transparent 0%,black 18%,black 97%,transparent 100%)}.hero-portrait :global(img){width:100%;height:100%;object-fit:contain;object-position:center bottom;mask-image:linear-gradient(to right,transparent,black 16%,black 95%,transparent);filter:saturate(.8) contrast(1.04);opacity:1}.portrait-halo{position:absolute;inset:12% 5% 5%;background:radial-gradient(ellipse,#b8894660,transparent 70%);filter:blur(30px)}
figcaption{position:absolute;right:13%;bottom:4%;text-align:right;display:grid;gap:8px}figcaption span{font-size:.56rem;letter-spacing:.24em;color:#d9ba87}figcaption em{font-family:var(--font-display);font-size:1.35rem}.hero-bottom{position:absolute;bottom:25px;left:0;right:0;z-index:3;display:flex;justify-content:space-between;align-items:center;gap:15px;border-top:1px solid var(--line);padding-top:20px;font-size:.6rem;letter-spacing:.15em;color:var(--ivory-faint)}.hero-bottom a{text-decoration:none}.hero-bottom button{background:none;border:0;color:var(--gold);font:inherit;cursor:pointer;min-height:44px}
:global(html.intro-pending) [data-hero-step],:global(html.intro-pending) .hero-bottom{opacity:0;transform:translateY(25px)}[data-hero-step]{transition:opacity 1.1s,transform 1.5s var(--ease-out)}[data-hero-step='3']{transition-delay:.15s}[data-hero-step='4']{transition-delay:.3s}[data-hero-step='5']{transition-delay:.5s}
@media(max-width:899px){.hero,.hero-inner{min-height:1120px}.hero-inner{display:block;padding-top:125px}.hero-copy{max-width:90%}h1{font-size:clamp(4.6rem,15vw,7rem)}.hero-portrait{height:54%;width:auto;max-width:96%;right:-6%;bottom:58px;opacity:.9}.hero-intro{max-width:37ch}.hero-bottom>span{display:none}.hero-ctas{flex-wrap:wrap;gap:15px}.hero-roles{font-size:.72rem}.hero-tagline{margin-top:24px}.hero-portrait figcaption{bottom:5%;right:22%}.hero-copy .eyebrow{font-size:.56rem}.hero-portrait :global(picture){mask-image:linear-gradient(to top,transparent,black 22%,black 66%,transparent 94%)}}
@media(prefers-reduced-motion:reduce){[data-hero-step]{transition:none!important;transform:none!important}}
</style>
<script>import { initHome } from '../scripts/home';initHome();</script>

