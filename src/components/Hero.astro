---
import { Picture } from 'astro:assets';
import { site } from '../data/site';
import { photos } from '../data/gallery';
---
<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="stage" data-globe-host data-globe aria-hidden="true">
    <canvas class="stage-canvas" data-globe-canvas></canvas>
    <div class="stage-fallback">
      <div class="horizon"></div>
    </div>
  </div>

  <div class="hero-inner container">
    <div class="hero-copy">
      <p class="hero-location" data-hero-step="1">{site.location.city}, {site.location.country}</p>
      <h1 id="hero-title" class="hero-name" tabindex="-1" data-hero-step="2">
        <span class="gold-text">Kalla</span>
        <span class="gold-text">Dhanush</span>
      </h1>
      <p class="hero-roles" data-hero-step="3">
        {site.roles.map((r, i) => (
          <>{i > 0 && ' '}<span class="role">{r}{i < site.roles.length - 1 && <span class="pipe"> |</span>}</span></>
        ))}
      </p>
      <p class="hero-tagline" data-hero-step="4">{site.tagline}</p>
      <div class="hero-ctas" data-hero-step="5">
        <a class="btn btn-gold" href="#about">Explore my world</a>
        <a class="btn" href="/about/">About me</a>
      </div>
    </div>

    <figure class="portrait" data-hero-step="portrait">
      <div class="portrait-frame">
        <Picture
          src={photos.heroStudioBike}
          alt="Kalla Dhanush seated on a motorcycle in a studio, looking down to his right."
          widths={[480, 640, 857]}
          sizes="(min-width: 960px) 44vw, 92vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="portrait-img"
        />
        <div class="portrait-light" aria-hidden="true"></div>
      </div>
    </figure>
  </div>

  <p class="drag-hint" aria-hidden="true">Drag the globe</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 640px);
    display: flex;
    align-items: stretch;
    overflow: hidden;
    isolation: isolate;
  }
  .stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: grab;
    touch-action: pan-y;
  }
  .hero:global(.is-dragging) .stage { cursor: grabbing; }
  .stage-canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }
  :global(.stage-ready) .stage-canvas { opacity: 1; }

  /* CSS horizon when WebGL is unavailable */
  .stage-fallback { display: none; }
  :global(.webgl-failed) .stage-fallback, :global(html.no-webgl) .stage-fallback { display: block; position: absolute; inset: 0; }
  .horizon {
    position: absolute;
    left: 50%;
    bottom: -150vmax;
    width: 180vmax;
    height: 180vmax;
    transform: translateX(-42%);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 2%, #3a2b18 0%, #0d0a07 18%, #000 40%);
    box-shadow: 0 -2px 0 rgb(241 220 166 / 0.6), 0 -30px 90px rgb(214 178 110 / 0.35);
  }
  @media (max-aspect-ratio: 9/10) { .horizon { bottom: -165vmax; } }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
    pointer-events: none;
  }
  .hero-inner :is(a, button, h1) { pointer-events: auto; }

  .hero-copy {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(2.5rem, 8vh, 5rem);
  }
  .hero-location {
    margin: 0 0 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ivory-dim);
    font-size: 0.9rem;
  }
  .hero-location::before {
    content: '';
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--ember);
    box-shadow: 0 0 0 4px rgb(226 129 60 / 0.18), 0 0 18px var(--ember);
  }
  .hero-name {
    font-size: var(--step-hero);
    line-height: 0.86;
    letter-spacing: -0.03em;
    font-weight: 600;
    font-variation-settings: 'opsz' 96;
    margin-left: -0.04em;
  }
  .hero-name span { display: block; }
  .hero-name span:last-child { padding-left: 0.5em; font-style: italic; font-weight: 500; }
  .hero-name:focus { outline: none; }
  .hero-roles {
    margin: 1.8rem 0 0;
    font-size: clamp(1rem, 0.9rem + 0.45vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ivory);
  }
  .role { white-space: nowrap; }
  .pipe { color: var(--gold); padding-left: 0.1em; }
  .hero-tagline {
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 1rem + 1.2vw, 2rem);
    color: var(--gold-bright);
  }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.2rem; }

  .portrait {
    margin: 0;
    position: relative;
    z-index: 1;
  }
  .portrait-frame {
    position: relative;
    isolation: isolate;
    /* the studio backdrop becomes a spotlight that dissolves into the dark */
    -webkit-mask-image:
      radial-gradient(ellipse 50% 50% at 54% 46%, #000 48%, transparent 99%),
      linear-gradient(to bottom, #000 70%, transparent 97%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(ellipse 50% 50% at 54% 46%, #000 48%, transparent 99%),
      linear-gradient(to bottom, #000 70%, transparent 97%);
    mask-composite: intersect;
  }
  .portrait-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .portrait-light {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* warm cinematic falloff on the backdrop; the centre (subject) is untouched */
    background: radial-gradient(ellipse 44% 50% at 58% 44%, transparent 58%, rgb(214 168 98) 82%, rgb(90 58 24) 100%);
    mix-blend-mode: multiply;
  }

  .drag-hint {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    z-index: 1;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--ivory-faint);
    pointer-events: none;
  }
  :global(html.no-webgl) .drag-hint, :global(.webgl-failed) ~ .drag-hint { display: none; }

  /* Mobile: portrait first, words over the horizon */
  @media (max-width: 959px) {
    .hero { min-height: auto; }
    .hero-inner { padding-top: calc(var(--header-h) + 0.5rem); }
    .portrait { order: -1; width: min(100%, 30rem); margin-inline: auto; }
    .portrait-frame { aspect-ratio: 4 / 4.6; }
    .hero-copy { margin-top: -4.5rem; padding-bottom: 13rem; }
    .hero-name span:last-child { padding-left: 0.35em; }
    .drag-hint { display: none; }
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: 1rem;
      min-height: max(100svh, 640px);
    }
    .hero-copy { align-self: center; padding-top: var(--header-h); padding-bottom: 6vh; }
    .portrait {
      align-self: end;
      height: min(94svh, 980px);
      margin-right: calc(-1 * var(--gutter));
    }
    .portrait-frame { height: 100%; }
  }

  /* Intro choreography: hero waits behind the curtain */
  :global(html.intro-pending) [data-hero-step],
  :global(html.intro-pending) .drag-hint { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.intro-pending) [data-hero-step] { transform: translateY(26px); }
    :global(html.intro-pending) [data-hero-step='portrait'] { transform: translateY(40px) scale(0.98); }
    [data-hero-step], .drag-hint { transition: opacity 1.2s var(--ease-out), transform 1.4s var(--ease-out); }
    [data-hero-step='1'] { transition-delay: 0.05s; }
    [data-hero-step='2'] { transition-delay: 0.15s; }
    [data-hero-step='3'] { transition-delay: 0.3s; }
    [data-hero-step='4'] { transition-delay: 0.4s; }
    [data-hero-step='5'] { transition-delay: 0.5s; }
    [data-hero-step='portrait'] { transition-delay: 0.1s; transition-duration: 1.8s; }
  }
</style>

<script>
  import { initHome } from '../scripts/home';
  initHome();
</script>
