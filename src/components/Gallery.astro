---
import { Picture, getImage } from 'astro:assets';
import type { Photo } from '../data/gallery';
interface Props { items: Photo[]; filters?: boolean; layout?: 'masonry' | 'mosaic' }
const { items, filters = true, layout = 'masonry' } = Astro.props;
const categories = [...new Set(items.map((p) => p.category))];
const large = await Promise.all(items.map((p) => getImage({ src: p.src, width: Math.min(1800, p.src.width), format: 'webp', quality: 82 })));
---
<div class="gallery" data-gallery>
  {filters && categories.length > 1 && (
    <div class="filters" role="group" aria-label="Filter photographs">
      <button type="button" aria-pressed="true" data-filter="all">All</button>
      {categories.map((c) => <button type="button" aria-pressed="false" data-filter={c}>{c}</button>)}
      <p class="count" aria-live="polite" data-count>{items.length} photographs</p>
    </div>
  )}
  <ul class:list={['grid', layout]}>
    {items.map((p, i) => (
      <li data-category={p.category} class:list={[{ tall: p.src.height > p.src.width * 1.2, wide: p.src.width > p.src.height * 1.3 }]}>
        <button
          type="button"
          class="thumb"
          data-index={i}
          data-full={large[i].src}
          data-caption={p.caption}
          data-alt={p.alt}
          data-w={large[i].attributes.width}
          data-h={large[i].attributes.height}
          aria-label={`Open photograph: ${p.caption}`}
        >
          <Picture
            src={p.src}
            alt={p.alt}
            widths={[360, 560, 820]}
            sizes={layout === 'mosaic' ? '(min-width: 900px) 30vw, 46vw' : '(min-width: 1100px) 30vw, (min-width: 640px) 46vw, 92vw'}
            formats={['avif', 'webp']}
            loading="lazy"
          />
          <span class="cap"><span class="cat">{p.category}</span>{p.caption}</span>
        </button>
      </li>
    ))}
  </ul>

  <dialog class="lightbox" aria-label="Photograph viewer" data-lightbox>
    <figure>
      <img data-lb-img alt="" />
      <figcaption data-lb-cap></figcaption>
    </figure>
    <button class="lb-btn lb-close" type="button" data-lb-close>Close</button>
    <button class="lb-btn lb-prev" type="button" data-lb-prev aria-label="Previous photograph">‹</button>
    <button class="lb-btn lb-next" type="button" data-lb-next aria-label="Next photograph">›</button>
    <p class="lb-pos" data-lb-pos></p>
  </dialog>
</div>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.75rem;
  }
  .filters button {
    min-height: 42px;
    padding: 0.45rem 1.05rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ivory-dim);
    font: 500 0.9rem/1 var(--font-sans);
    cursor: pointer;
  }
  .filters button:hover { color: var(--ivory); border-color: var(--line-strong); }
  .filters button[aria-pressed='true'] { background: var(--metal); color: #120d06; border-color: transparent; }
  .count { margin: 0 0 0 auto; font-size: 0.85rem; color: var(--ivory-faint); }

  .grid { list-style: none; margin: 0; padding: 0; }
  .grid.masonry { columns: 3 300px; column-gap: 1rem; }
  .grid.masonry li { break-inside: avoid; margin-bottom: 1rem; }
  .grid.mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (min-width: 900px) { .grid.mosaic { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; } }
  .grid.mosaic .thumb :global(img) { aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 35%; }
  li[hidden] { display: none; }

  .thumb {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--charcoal);
    cursor: zoom-in;
  }
  .thumb :global(img) {
    width: 100%;
    transition: transform 1.2s var(--ease-out), filter 0.8s;
    filter: saturate(0.92) contrast(1.02);
  }
  .thumb:hover :global(img), .thumb:focus-visible :global(img) { transform: scale(1.035); filter: saturate(1.02); }
  .cap {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 0.15rem;
    padding: 2.2rem 1rem 0.9rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.82), transparent);
    color: var(--ivory);
    font-family: var(--font-display);
    font-size: 1.1rem;
    text-align: left;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s, transform 0.6s var(--ease-out);
  }
  .cat { font-family: var(--font-sans); font-size: 0.75rem; color: var(--gold); }
  .thumb:hover .cap, .thumb:focus-visible .cap { opacity: 1; transform: none; }
  @media (hover: none) { .cap { opacity: 1; transform: none; } }

  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.95);
    color: var(--ivory);
  }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.8); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: 4.5rem 4.5rem 3.5rem;
    max-width: 100%;
    max-height: 100%;
  }
  .lightbox img {
    max-width: min(92vw, 1400px);
    max-height: calc(100svh - 10rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 40px 120px -40px rgb(214 178 110 / 0.35);
  }
  .lightbox figcaption { font-family: var(--font-display); font-style: italic; font-size: 1.2rem; color: var(--gold-bright); text-align: center; }
  .lb-btn {
    position: absolute;
    min-width: 48px; min-height: 48px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.5);
    color: var(--ivory);
    font: 500 1rem/1 var(--font-sans);
    cursor: pointer;
  }
  .lb-btn:hover { border-color: var(--gold); color: var(--gold-bright); }
  .lb-close { top: 1rem; right: 1rem; padding: 0 1.2rem; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600; }
  .lb-prev, .lb-next { top: 50%; transform: translateY(-50%); font-size: 1.8rem; }
  .lb-prev { left: 1rem; }
  .lb-next { right: 1rem; }
  .lb-pos { position: absolute; top: 1.6rem; left: 1.4rem; margin: 0; font-size: 0.85rem; color: var(--ivory-faint); }
  @media (max-width: 640px) {
    .lightbox figure { padding: 4rem 0.75rem 5.5rem; }
    .lb-prev, .lb-next { top: auto; bottom: 1rem; transform: none; }
    .lb-prev { left: calc(50% - 60px); }
    .lb-next { right: calc(50% - 60px); }
  }
</style>

<script>
  import { initGallery } from '../scripts/gallery';
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>
