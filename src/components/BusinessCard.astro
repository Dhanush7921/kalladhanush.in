---
import { url } from '../lib/url';
import { site, contact, whatsappLink } from '../data/site';
---
<div class="card-scene" data-bizcard>
  <div class="card" data-card>
    <div class="face front">
      <span class="mark gold-text" aria-hidden="true">D.</span>
      <div class="front-text">
        <p class="name">{site.nameUpper}</p>
        <p class="role">
          {site.roles.map((r, i) => (
            <>{i > 0 && ' '}<span class="nw">{r}{i < site.roles.length - 1 && ' |'}</span></>
          ))}
        </p>
      </div>
      <p class="card-tagline">{site.tagline}</p>
      <span class="sheen" aria-hidden="true"></span>
    </div>
    <div class="face back">
      <p class="back-title">Get in touch</p>
      <ul>
        <li><span>Email</span><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><span>WhatsApp</span><a href={whatsappLink()} target="_blank" rel="noopener">{contact.whatsappDisplay}</a></li>
        <li><span>Instagram</span><a href={contact.instagram} target="_blank" rel="noopener">{contact.instagramHandle}</a></li>
        <li><span>Based in</span><span class="v">{site.location.city}, {site.location.country}</span></li>
      </ul>
      <a class="btn btn-small btn-gold" href={url('/kalla-dhanush.vcf')} download>Save contact</a>
    </div>
  </div>
  <button class="flip btn btn-small" type="button" data-card-flip aria-pressed="false">Flip card</button>
</div>

<style>
  .card-scene {
    --rx: 0deg; --ry: 0deg;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    perspective: 1400px;
  }
  .card {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1.75;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(calc(var(--ry) + var(--flip, 0deg)));
    transition: transform 1s var(--ease-out);
  }
  .card-scene.is-flipped { --flip: 180deg; }
  .face {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 50px 90px -40px rgb(0 0 0 / 0.9), 0 0 60px -20px rgb(214 178 110 / 0.35);
  }
  .front {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    align-items: center;
    gap: 0 1.25rem;
    padding: clamp(1.2rem, 4vw, 2rem);
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(214 178 110 / 0.2), transparent 55%),
      linear-gradient(135deg, #1d1813, #070605 70%);
  }
  .mark { font-family: var(--font-display); font-weight: 700; font-size: clamp(3.5rem, 12vw, 5.5rem); line-height: 0.9; font-variation-settings: 'opsz' 96; }
  .name { margin: 0; font-size: clamp(0.8rem, 2.6vw, 1rem); font-weight: 600; letter-spacing: 0.3em; }
  .role { margin: 0.4rem 0 0; font-size: clamp(0.72rem, 2.2vw, 0.85rem); color: var(--ivory-dim); }
  .nw { white-space: nowrap; }
  .card-tagline { grid-column: 1 / -1; margin: 0; font-family: var(--font-display); font-style: italic; color: var(--gold); font-size: clamp(0.95rem, 3vw, 1.15rem); }
  .sheen {
    position: absolute;
    inset: -50%;
    background: linear-gradient(115deg, transparent 40%, rgb(255 240 200 / 0.12) 50%, transparent 60%);
    transform: translateX(calc(var(--ry) * 4));
    pointer-events: none;
  }
  .back {
    transform: rotateY(180deg);
    display: grid;
    align-content: center;
    gap: 0.8rem;
    padding: clamp(1rem, 4vw, 1.75rem);
    background: linear-gradient(135deg, #0b0907, #1a1510);
  }
  .back-title { margin: 0; font-family: var(--font-display); font-size: 1.25rem; color: var(--gold-bright); }
  .back ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; font-size: clamp(0.72rem, 2.4vw, 0.9rem); }
  .back li { display: grid; grid-template-columns: 6.5em 1fr; gap: 0.5rem; }
  .back li > span:first-child { color: var(--ivory-faint); }
  .back a { color: var(--ivory); overflow-wrap: anywhere; }
  .back .btn { justify-self: start; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-bizcard]').forEach((scene) => {
    const btn = scene.querySelector<HTMLButtonElement>('[data-card-flip]')!;
    const card = scene.querySelector<HTMLElement>('[data-card]')!;
    const faces = card.querySelectorAll<HTMLElement>('.face');
    const sync = () => {
      const flipped = scene.classList.contains('is-flipped');
      btn.setAttribute('aria-pressed', String(flipped));
      btn.textContent = flipped ? 'Show front' : 'Flip card';
      faces[0].inert = flipped;
      faces[1].inert = !flipped;
      faces[0].setAttribute('aria-hidden', String(flipped));
      faces[1].setAttribute('aria-hidden', String(!flipped));
    };
    btn.addEventListener('click', () => { scene.classList.toggle('is-flipped'); sync(); });
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      scene.classList.toggle('is-flipped');
      sync();
    });
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      scene.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        scene.style.setProperty('--ry', `${(((e.clientX - r.left) / r.width - 0.5) * 16).toFixed(1)}deg`);
        scene.style.setProperty('--rx', `${(-((e.clientY - r.top) / r.height - 0.5) * 12).toFixed(1)}deg`);
      });
      scene.addEventListener('pointerleave', () => { scene.style.setProperty('--ry', '0deg'); scene.style.setProperty('--rx', '0deg'); });
    }
    sync();
  });
</script>
