---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import { nav } from '../data/site';
---
<Base title="Page not found" noindex>
  <section class="lost">
    <div class="container">
      <p class="code gold-text" aria-hidden="true">404</p>
      <h1>This page drifted out of orbit.</h1>
      <p class="lede">The address may have changed or never existed. Head back home, or choose a page below.</p>
      <div class="actions">
        <a class="btn btn-gold" href={url('/')}>Back to home</a>
        <a class="btn" href={url('/contact/')}>Report a broken link</a>
      </div>
      <ul class="links">
        {nav.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: calc(var(--header-h) + 3rem) 0 4rem;
    background: radial-gradient(60vmax 40vmax at 80% 20%, rgb(154 106 58 / 0.2), transparent 60%);
  }
  .code {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 4rem + 14vw, 16rem);
    line-height: 0.85;
    font-variation-settings: 'opsz' 96;
  }
  h1 { font-size: var(--step-4); margin: 1.5rem 0 1rem; max-width: 18ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .links { list-style: none; margin: 3rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .links a { color: var(--ivory-dim); }
</style>
