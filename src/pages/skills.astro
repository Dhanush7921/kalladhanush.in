---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SkillUniverse from '../components/SkillUniverse.astro';
import { skillGroups } from '../data/skills';
import { publishedProjects } from '../data/projects';
const title = (slug: string) => publishedProjects.find((p) => p.slug === slug)?.title;
---
<Base title="Skills & expertise" description="AI & ML, web and app development, embedded systems, UI/UX, photography and video editing — the skills of Kalla Dhanush, linked to real projects.">
  <PageHero
    title="Skills & expertise"
    lede="Spin the universe, or pick a discipline from the dashboard. Every skill links back to where it was actually used."
  />

  <section class="chapter" aria-label="Skill universe">
    <div class="container">
      <SkillUniverse idPrefix="skills-page" />
    </div>
  </section>

  <section class="chapter" aria-labelledby="overview-title">
    <div class="container">
      <h2 id="overview-title" class="display-l overview-title">The full overview</h2>
      <div class="table-wrap">
        <table>
          <caption class="visually-hidden">Skills by discipline, with evidence and related projects</caption>
          <thead>
            <tr><th scope="col">Discipline</th><th scope="col">Skills</th><th scope="col">Where it shows</th></tr>
          </thead>
          <tbody>
            {skillGroups.map((g) => (
              <tr>
                <th scope="row">{g.name}</th>
                <td>{g.skills.join(', ')}</td>
                <td>
                  {g.evidence}
                  {g.projects.filter(title).length > 0 && (
                    <span class="proj">
                      {g.projects.filter(title).map((s) => <a class="text-link" href={`/projects/${s}/`}>{title(s)}</a>)}
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<style>
  .overview-title { margin-bottom: 2rem; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-m); }
  table { width: 100%; border-collapse: collapse; min-width: 720px; }
  th, td { text-align: left; vertical-align: top; padding: 1.1rem 1.25rem; border-bottom: 1px solid var(--line); }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { font-size: 0.82rem; font-weight: 600; color: var(--gold); background: rgb(28 25 20 / 0.6); }
  tbody th { font-family: var(--font-display); font-size: 1.2rem; font-weight: 500; width: 22%; }
  td { color: var(--ivory-dim); font-size: 0.96rem; }
  .proj { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; margin-top: 0.5rem; }
</style>
