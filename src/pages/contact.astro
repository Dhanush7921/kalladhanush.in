---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactHub from '../components/ContactHub.astro';
import BusinessCard from '../components/BusinessCard.astro';
import { site, contact, whatsappLink } from '../data/site';

const channels = [
  { label: 'Email', value: contact.email, href: `mailto:${contact.email}`, external: false },
  { label: 'WhatsApp', value: contact.whatsappDisplay, href: whatsappLink(), external: true },
  { label: 'Instagram', value: contact.instagramHandle, href: contact.instagram, external: true },
  { label: 'GitHub', value: contact.githubHandle, href: contact.github, external: true },
];
---
<Base title="Connect" description={`Contact ${site.name} for employment, collaboration, creative partnerships or a general message.`}>
  <PageHero
    title="Connection hub"
    lede="Employment, collaboration, a creative partnership or simply hello — choose what it's about and send it the way you prefer."
  />

  <section class="chapter" aria-label="Contact options">
    <div class="container grid">
      <ContactHub />
      <div class="side">
        <BusinessCard />
        <ul class="channels">
          {channels.map((c) => (
            <li>
              <span class="k">{c.label}</span>
              <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>{c.value}</a>
            </li>
          ))}
        </ul>
        <p class="where">Based in {site.location.city}, {site.location.country} (IST, UTC+5:30).</p>
        {contact.resume && <a class="btn" href={contact.resume} download>Download résumé</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 1000px) { .grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); } }
  .side { display: grid; gap: 2rem; }
  .channels { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .channels li { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 0.95rem 0; border-bottom: 1px solid var(--line); }
  .k { color: var(--gold); font-size: 0.9rem; }
  .channels a { overflow-wrap: anywhere; }
  .where { margin: 0; color: var(--ivory-faint); font-size: 0.9rem; }
</style>
