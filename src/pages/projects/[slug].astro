---
import { url } from '../../lib/url';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { publishedProjects, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
  publishedProjects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: publishedProjects[(i - 1 + publishedProjects.length) % publishedProjects.length],
      next: publishedProjects[(i + 1) % publishedProjects.length],
    },
  }))) satisfies GetStaticPaths;

interface Props { project: Project; prev: Project; next: Project }
const { project: p, prev, next } = Astro.props;
const sections = [
  { id: 'problem', title: 'The problem', body: p.problem },
  { id: 'solution', title: 'The solution', body: p.solution },
  { id: 'role', title: 'My role', body: p.role },
].filter((s) => s.body);
---
<Base title={`${p.title} — ${p.subtitle}`} description={p.summary}>
  <PageHero title={p.title} lede={p.summary} crumb={{ href: url('/projects/'), label: 'All projects' }}>
    <dl class="meta">
      <div><dt>Type</dt><dd>{p.category}</dd></div>
      <div><dt>Status</dt><dd><span class="status" data-status={p.status}>{p.status}</span></dd></div>
      <div><dt>Focus</dt><dd>{p.subtitle}</dd></div>
    </dl>
  </PageHero>

  <section class="chapter detail">
    <div class="container detail-grid">
      <div class="cover" aria-hidden="true">
        <span class="mark">{p.mark}</span>
        <span class="ring r1"></span><span class="ring r2"></span>
      </div>

      <div class="content">
        {sections.map((s) => (
          <section aria-labelledby={`${s.id}-h`}>
            <h2 id={`${s.id}-h`}>{s.title}</h2>
            <p>{s.body}</p>
          </section>
        ))}

        {p.features && (
          <section aria-labelledby="features-h">
            <h2 id="features-h">Key features</h2>
            <ul class="features">{p.features.map((f) => <li>{f}</li>)}</ul>
          </section>
        )}

        {p.technologies && (
          <section aria-labelledby="tech-h">
            <h2 id="tech-h">Technologies</h2>
            <ul class="tech">{p.technologies.map((t) => <li class="tag">{t}</li>)}</ul>
          </section>
        )}

        {p.statusNote && (
          <section aria-labelledby="status-h">
            <h2 id="status-h">Where it stands</h2>
            <p>{p.statusNote}</p>
          </section>
        )}

        <section aria-labelledby="media-h">
          <h2 id="media-h">Media</h2>
          <p class="muted">
            Screenshots are published only when they are real and cleared for release. None are public for this project yet.
          </p>
        </section>

        {p.link && <p><a class="btn btn-gold" href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a></p>}
      </div>
    </div>
  </section>

  <nav class="pager container" aria-label="More projects">
    <a href={url(`/projects/${prev.slug}/`)} class="prev"><span>Previous</span>{prev.title}</a>
    <a href={url(`/projects/${next.slug}/`)} class="next"><span>Next</span>{next.title}</a>
  </nav>
</Base>

<style>
  .meta { display: flex; flex-wrap: wrap; gap: 1rem 3rem; margin: 2.25rem 0 0; }
  .meta dt { font-size: 0.82rem; color: var(--gold); }
  .meta dd { margin: 0.2rem 0 0; }
  .detail-grid { display: grid; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  @media (min-width: 960px) { .detail-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); } }
  .cover {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background:
      radial-gradient(60% 60% at 35% 30%, rgb(214 178 110 / 0.22), transparent 70%),
      radial-gradient(50% 60% at 85% 95%, rgb(226 129 60 / 0.14), transparent 70%),
      #0a0806;
    overflow: hidden;
  }
  @media (max-width: 959px) { .cover { position: relative; top: 0; aspect-ratio: 16 / 10; } }
  .mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(5rem, 4rem + 8vw, 11rem);
    line-height: 1;
    font-variation-settings: 'opsz' 96;
    background: var(--metal);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ring { position: absolute; border: 1px solid var(--line-strong); border-radius: 50%; }
  .r1 { width: 86%; aspect-ratio: 2.6; transform: rotate(-14deg); }
  .r2 { width: 64%; aspect-ratio: 1.6; transform: rotate(22deg); opacity: 0.5; }
  @media (prefers-reduced-motion: no-preference) {
    .r1 { animation: orbit 26s linear infinite; }
    .r2 { animation: orbit 34s linear infinite reverse; }
  }
  @keyframes orbit { to { rotate: 360deg; } }
  .content { display: grid; gap: 2.5rem; max-width: 64ch; }
  .content h2 { font-size: var(--step-3); margin-bottom: 0.9rem; }
  .content p { color: var(--ivory-dim); font-size: 1.08rem; line-height: 1.75; }
  .features { margin: 0; padding-left: 1.2rem; color: var(--ivory-dim); display: grid; gap: 0.55rem; }
  .features li::marker { color: var(--gold); }
  .tech { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .tech .tag { color: var(--ivory); font-size: 0.92rem; }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-bottom: clamp(4rem, 10vh, 7rem);
  }
  .pager a {
    display: grid;
    gap: 0.3rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--step-2);
    transition: border-color 0.3s;
  }
  .pager a:hover { border-color: var(--gold); }
  .pager span { font-family: var(--font-sans); font-size: 0.82rem; color: var(--gold); }
  .pager .next { text-align: right; }
</style>
