---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Timeline from '../components/Timeline.astro';
import { publishedJourney } from '../data/journey';

const kinds = [...new Set(publishedJourney.map((j) => j.kind))];
---
<Base title="My journey" description="Education, experience and milestones of Kalla Dhanush — from EEE to AI & ML, Tierra Automation and his own products.">
  <PageHero
    title="My journey"
    lede="Education, experience and the projects that marked each step. Select any milestone to expand it."
  >
    <ul class="legend" aria-label="Milestone types">
      {kinds.map((k) => <li data-kind={k}>{k}</li>)}
    </ul>
  </PageHero>

  <section class="chapter" aria-label="Timeline">
    <div class="container narrow">
      <Timeline entries={publishedJourney} />
      <p class="note">
        Academic years are left out on purpose until they are confirmed. Results are shown exactly as awarded.
      </p>
      <div class="next">
        <a class="btn btn-gold" href={url('/projects/')}>See the projects</a>
        <a class="btn" href={url('/skills/')}>Skills &amp; expertise</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 900px; }
  .legend { list-style: none; margin: 2rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; font-size: 0.9rem; color: var(--ivory-dim); }
  .legend li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .legend li::before { content: ''; width: 9px; height: 9px; border-radius: 50%; border: 1px solid var(--gold); }
  .legend li[data-kind='Experience']::before { border-color: var(--ember); background: var(--ember); }
  .note { margin-top: 2rem; font-size: 0.88rem; color: var(--ivory-faint); }
  .next { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
