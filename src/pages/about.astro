---
import { url } from '../lib/url';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Gallery from '../components/Gallery.astro';
import { site, contact } from '../data/site';
import { publishedGallery, photos } from '../data/gallery';

const portraits = ['seaside', 'heritage-portrait', 'olive-shirt', 'night-garden']
  .map((id) => publishedGallery.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => !!p);

const facts = [
  { k: 'Known as', v: site.knownAs },
  { k: 'Based in', v: `${site.location.city}, ${site.location.country}` },
  { k: 'Focus', v: site.title },
  { k: 'Also', v: site.otherExpertise.join(', ') },
  { k: 'Education', v: 'Computer Science & Engineering (AI & ML), ANITS' },
  { k: 'Currently', v: 'Technology & Development Trainee (provisional), Tierra Automation — since September 2026' },
];
const interests = ['Motorcycles', 'Travel', 'Photography', 'Videography', 'Fitness', 'Creative direction'];
---
<Base title="About me" description={`About ${site.name} (${site.knownAs}) — ${site.title}, based in ${site.location.city}.`}>
  <PageHero
    title="About me"
    lede="An engineer, a video editor and a photographer: one person, three crafts, from Visakhapatnam."
  />

  <section class="chapter story">
    <div class="container story-grid">
      <figure class="lead-photo">
        <Picture
          src={photos.portraitNight}
          alt="Dhanush in a light shirt at night among illuminated banana leaves."
          widths={[420, 640, 900]}
          sizes="(min-width: 960px) 38vw, 92vw"
          formats={['avif', 'webp']}
          loading="eager"
        />
      </figure>
      <div class="prose">
        <h2 class="display-l">My story</h2>
        <p>
          I'm <strong>{site.name}</strong>, known to most people as <strong>{site.knownAs}</strong>. I'm based in
          {site.location.city}, India, and I describe myself as a multidisciplinary creator: an AI &amp; ML engineer,
          a video editor and a photographer, with full-stack web and app development running through all of it.
        </p>
        <p>
          My technical path began with electrical and electronics engineering at Sai Ganapathi Polytechnic, which gave
          me a feel for circuits and hardware. I then moved into Computer Science &amp; Engineering with a specialisation in
          Artificial Intelligence &amp; Machine Learning at ANITS. That combination is why my work spans
          mobile apps, web platforms, interactive 3D websites and embedded hardware.
        </p>
        <p>
          Since September 2026 I've been a Technology &amp; Development Trainee (provisional) at Tierra Automation,
          a Visakhapatnam company working across embedded systems, IoT, web, apps and robotics. Alongside it I build
          my own products — <a class="text-link" href={url('/projects/spendly/')}>Spendly</a>, a personal finance app, and
          <a class="text-link" href={url('/projects/route-plus/')}>ROUTE+</a>, route-aware travel discovery for India.
        </p>
        <p>
          Away from the keyboard you'll find me around motorcycles, in the hills, or behind and in front of a camera.
        </p>
      </div>
    </div>
  </section>

  <section class="chapter">
    <div class="container values-grid">
      <div>
        <h2 class="display-l">What I stand by</h2>
        <ul class="philosophy">
          {site.philosophy.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <dl class="facts">
        {facts.map((f) => (
          <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="chapter">
    <div class="container">
      <div class="chapter-head split">
        <h2 class="display-l">Portraits</h2>
        <div>
          <p class="lede">A few frames from in front of the lens.</p>
          <ul class="interests" aria-label="Interests">
            {interests.map((i) => <li class="tag">{i}</li>)}
          </ul>
        </div>
      </div>
      <Gallery items={portraits} filters={false} />
      <div class="next-links">
        <a class="btn btn-gold" href={url('/journey/')}>Follow my journey</a>
        <a class="btn" href={url('/world/')}>See my world</a>
        <a class="btn" href={`mailto:${contact.email}`}>Email me</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .story-grid { display: grid; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  @media (min-width: 960px) { .story-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); } }
  .lead-photo { margin: 0; position: sticky; top: calc(var(--header-h) + 2rem); }
  .lead-photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 4px; }
  @media (max-width: 959px) { .lead-photo { position: relative; top: 0; } }
  .prose { max-width: 62ch; }
  .prose h2 { margin-bottom: 1.75rem; }
  .prose p { font-size: 1.12rem; line-height: 1.75; color: var(--ivory-dim); }
  .prose strong { color: var(--ivory); font-weight: 600; }
  .values-grid { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .values-grid { grid-template-columns: 1fr 1fr; align-items: start; } }
  .philosophy { list-style: none; margin: 1.75rem 0 0; padding: 0; font-family: var(--font-display); font-size: var(--step-3); line-height: 1.2; }
  .philosophy li:nth-child(2) { color: var(--ivory-dim); }
  .philosophy li:nth-child(3) { color: var(--gold); font-style: italic; }
  .facts { margin: 0; display: grid; border-top: 1px solid var(--line); }
  .facts div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .facts dt { color: var(--gold); font-size: 0.92rem; }
  .facts dd { margin: 0; color: var(--ivory); }
  .interests { list-style: none; margin: 1.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .next-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.5rem; }
  @media (max-width: 520px) { .facts div { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
