---
import { url } from '../lib/url';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillUniverse from '../components/SkillUniverse.astro';
import Gallery from '../components/Gallery.astro';
import BusinessCard from '../components/BusinessCard.astro';
import { site, contact, whatsappLink } from '../data/site';
import { publishedJourney } from '../data/journey';
import { publishedProjects } from '../data/projects';
import { publishedGallery, photos } from '../data/gallery';
import { horizons, visionStatement } from '../data/vision';

const chapters = [
  { id: 'about', label: 'About' },
  { id: 'journey', label: 'Journey' },
  { id: 'work', label: 'Work' },
  { id: 'skills', label: 'Skills' },
  { id: 'world', label: 'My World' },
  { id: 'vision', label: 'Vision' },
  { id: 'connect', label: 'Connect' },
];
const worldPicks = ['hills-sunrise', 'bikes-field', 'heritage-wide', 'bikes-arms-crossed', 'hills-ridge', 'night-garden']
  .map((id) => publishedGallery.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => !!p);
---
<Base intro chapters={chapters}>
  <Intro slot="intro" />
  <Hero />

  <section class="chapter about" id="about" aria-labelledby="about-title">
    <div class="container about-grid">
      <figure class="about-photo">
        <Picture
          src={photos.portraitSeaside}
          alt="Dhanush in a white shirt and sunglasses by the sea."
          widths={[420, 640, 900]}
          sizes="(min-width: 900px) 40vw, 92vw"
          formats={['avif', 'webp']}
        />
        <span class="frame" aria-hidden="true"></span>
      </figure>
      <div class="about-copy">
        <h2 id="about-title" class="display-xl">The multidisciplinary creator</h2>
        <p class="lede">
          I'm {site.name} — {site.knownAs} to most people — from {site.location.city}. I work where engineering
          meets visual storytelling: AI and machine learning, full-stack web and app development, video editing and photography.
        </p>
        <ul class="philosophy">
          {site.philosophy.map((p) => <li>{p}</li>)}
        </ul>
        <a class="btn" href={url('/about/')}>Read my story</a>
      </div>
    </div>
  </section>

  <section class="chapter" id="journey" aria-labelledby="journey-title">
    <div class="container">
      <div class="chapter-head split">
        <h2 id="journey-title" class="display-xl">The journey so far</h2>
        <p class="lede">From electrical engineering to AI &amp; ML, from first models to real products. Open any milestone for the details.</p>
      </div>
      <Timeline entries={publishedJourney} compact />
      <p class="more"><a class="text-link" href={url('/journey/')}>See the full journey</a></p>
    </div>
  </section>

  <section class="chapter" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="chapter-head split">
        <h2 id="work-title" class="display-xl">Selected work</h2>
        <p class="lede">A finance app, a travel platform and the website you are on now. Company and client work appears here once it is cleared for public release.</p>
      </div>
      <div class="cards">
        {publishedProjects.map((p) => <ProjectCard project={p} />)}
      </div>
      <p class="more"><a class="text-link" href={url('/projects/')}>All projects and details</a></p>
    </div>
  </section>

  <section class="chapter" id="skills" aria-labelledby="skills-title">
    <div class="container">
      <div class="chapter-head split">
        <h2 id="skills-title" class="display-xl">Skills &amp; expertise</h2>
        <p class="lede">Seven disciplines, one way of working. Every skill here is backed by real work — no self-scored percentages.</p>
      </div>
      <SkillUniverse idPrefix="home-skills" />
      <p class="more"><a class="text-link" href={url('/skills/')}>Explore skills in depth</a></p>
    </div>
  </section>

  <section class="chapter" id="world" aria-labelledby="world-title">
    <div class="container">
      <div class="chapter-head split">
        <h2 id="world-title" class="display-xl">My world</h2>
        <p class="lede">Bikes, hills at first light and portraits — the life around the work.</p>
      </div>
      <Gallery items={worldPicks} filters={false} layout="mosaic" />
      <p class="more"><a class="text-link" href={url('/world/')}>Open the full gallery</a></p>
    </div>
  </section>

  <section class="chapter" id="vision" aria-labelledby="vision-title">
    <div class="container">
      <div class="chapter-head">
        <h2 id="vision-title" class="display-xl">Vision &amp; roadmap</h2>
        <p class="vision-statement">{visionStatement}</p>
      </div>
      <ol class="horizons">
        {horizons.map((h) => (
          <li>
            <p class="h-kind" data-kind={h.kind}>{h.kind}</p>
            <h3>{h.name}</h3>
            <ul>{h.items.map((it) => <li>{it.title}</li>)}</ul>
          </li>
        ))}
      </ol>
      <p class="more"><a class="text-link" href={url('/vision/')}>Read the full roadmap</a></p>
    </div>
  </section>

  <section class="chapter connect" id="connect" aria-labelledby="connect-title">
    <div class="container connect-grid">
      <div>
        <h2 id="connect-title" class="display-xl">Start a conversation</h2>
        <p class="lede">Hiring, collaborating or planning a shoot? Reach me directly.</p>
        <div class="connect-actions">
          <a class="btn btn-gold" href={`mailto:${contact.email}`}>Email me</a>
          <a class="btn" href={whatsappLink('Hi Dhanush, I found you through kalladhanush.in.')} target="_blank" rel="noopener">WhatsApp</a>
          <a class="btn" href={contact.instagram} target="_blank" rel="noopener">Instagram</a>
        </div>
        <p class="more"><a class="text-link" href={url('/contact/')}>Open the connection hub</a></p>
      </div>
      <BusinessCard />
    </div>
  </section>
</Base>

<style>
  .about-grid { display: grid; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  @media (min-width: 900px) { .about-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); } }
  .about-photo { position: relative; margin: 0; }
  .about-photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: 4px; }
  .frame {
    position: absolute;
    inset: 0.75rem -0.75rem -0.75rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    z-index: -1;
  }
  .about-copy { display: grid; gap: 1.6rem; justify-items: start; }
  .about-copy .lede { margin: 0; }
  .about-copy h2 { font-size: var(--step-4); hyphens: auto; }
  .philosophy { list-style: none; margin: 0; padding: 0; font-family: var(--font-display); font-size: var(--step-2); line-height: 1.3; }
  .philosophy li:nth-child(2) { color: var(--ivory-dim); }
  .philosophy li:nth-child(3) { color: var(--gold); font-style: italic; }

  .more { margin-top: 2.25rem; }
  .cards { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); }

  .vision-statement {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.35;
    max-width: 38ch;
    color: var(--ivory-dim);
    margin: 0;
  }
  .horizons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    border-top: 1px solid var(--line);
  }
  .horizons > li { padding: 1.75rem 1.5rem 1.75rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 840px) {
    .horizons > li { border-bottom: 0; padding-left: 1.5rem; border-left: 1px solid var(--line); }
    .horizons > li:first-child { padding-left: 0; border-left: 0; }
  }
  .h-kind { margin: 0 0 0.5rem; font-size: 0.82rem; color: var(--gold); }
  .h-kind[data-kind='In progress'] { color: var(--ember); }
  .horizons h3 { font-size: var(--step-3); margin-bottom: 1rem; }
  .horizons ul { margin: 0; padding-left: 1.1rem; color: var(--ivory-dim); }
  .horizons ul li { margin-bottom: 0.4rem; }
  .horizons ul li::marker { color: var(--gold); }

  .connect-grid { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  @media (min-width: 960px) { .connect-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .connect .lede { margin: 1.5rem 0 2rem; }
  .connect-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
