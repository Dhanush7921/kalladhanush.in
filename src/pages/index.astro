---
import { url } from '../lib/url';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import ProjectStage from '../components/ProjectStage.astro';
import SkillUniverse from '../components/SkillUniverse.astro';
import WorldStage from '../components/WorldStage.astro';
import BusinessCard from '../components/BusinessCard.astro';
import { contact, mailtoLink, whatsappLink } from '../data/site';
import { publishedJourney } from '../data/journey';
import { photos } from '../data/gallery';
import { horizons } from '../data/vision';
const chapters = [{id:'about',label:'Identity'},{id:'work',label:'Work'},{id:'skills',label:'Skills'},{id:'journey',label:'Journey'},{id:'world',label:'My World'},{id:'vision',label:'Vision'},{id:'journal',label:'Journal'},{id:'connect',label:'Connect'}];
---
<Base intro chapters={chapters}>
<Intro slot="intro"/><Hero/>
<div class="manifesto-band"><span>ENGINEER.</span><span>CREATE.</span><span class="gold-text">TRANSCEND.</span><span class="band-star">✧</span></div>
<section class="chapter identity-chapter" id="about" aria-labelledby="about-title">
 <div class="container identity-grid">
  <figure class="identity-portrait" data-reveal><Picture src={photos.portraitOlive} alt="Dhanush in an olive shirt beside a carved stone pillar." widths={[400,650,900]} sizes="(min-width:900px) 35vw, 85vw" formats={['webp']}/><figcaption>01 / THE PERSON BEHIND THE VISION</figcaption></figure>
  <div class="identity-copy" data-reveal><p class="eyebrow">01 — IDENTITY</p><h2 class="display-xl" id="about-title">An engineer's mind.<br/><em>A creator's eye.</em></h2><p class="lede">I'm Kalla Dhanush. I work where technology meets imagination.</p><p>From electrical engineering to AI &amp; ML, from mobile products to visual storytelling — every discipline gives me a different way to turn an idea into something real.</p><blockquote>“Dream beyond limits.<br/>Build with purpose.<br/><em>Lead with vision.</em>”</blockquote><a class="text-link" href={url('/about/')}>The person behind the vision</a></div>
 </div>
</section>
<section class="chapter work-chapter" id="work" aria-labelledby="work-title">
 <div class="container"><div class="chapter-head split" data-reveal><div><p class="eyebrow">02 — SELECTED WORK</p><h2 id="work-title" class="display-xl">Ideas, made <em>real.</em></h2></div><p class="lede">Useful products. Thoughtful experiences.<br/>Select an object. Explore the story behind it.</p></div><ProjectStage/></div>
</section>
<section class="chapter skills-chapter" id="skills" aria-labelledby="skills-title">
 <div class="container"><div class="chapter-head split" data-reveal><div><p class="eyebrow">03 — THE CAPABILITY CONSTELLATION</p><h2 id="skills-title" class="display-xl">Many disciplines.<br/><em>One orbit.</em></h2></div><p class="lede">Engineering and creativity, connected.<br/>Choose a node to explore the work behind the skill.</p></div><SkillUniverse idPrefix="home-skills"/></div>
</section>
<section class="chapter journey-chapter" id="journey" aria-labelledby="journey-title">
 <div class="container"><div class="chapter-head split" data-reveal><div><p class="eyebrow">04 — THE JOURNEY</p><h2 id="journey-title" class="display-xl">Built, one<br/><em>chapter at a time.</em></h2></div><p class="lede">A foundation in hardware.<br/>An expanding world of software and creativity.</p></div><Timeline entries={publishedJourney} compact/><a class="text-link more-link" href={url('/journey/')}>Explore every milestone</a></div>
</section>
<section class="chapter world-chapter" id="world" aria-labelledby="world-title"><div class="container"><div class="chapter-head" data-reveal><p class="eyebrow">05 — OUTSIDE THE FRAME</p><h2 id="world-title" class="display-xl">Welcome to <em>my world.</em></h2></div><WorldStage/></div></section>
<section class="chapter vision-chapter" id="vision" aria-labelledby="vision-title"><div class="container"><div class="chapter-head" data-reveal><p class="eyebrow">06 — THE HORIZON</p><h2 id="vision-title" class="display-xl">A bigger <em>tomorrow.</em></h2><p class="lede">The direction I am working toward. Goals, not claimed achievements.</p></div><ol class="roadmap">{horizons.map((h,i)=><li data-reveal><span class="road-node">0{i+1}</span><p class="eyebrow">{h.kind}</p><h3>{h.name}</h3><ul>{h.items.map(it=><li>{it.title}</li>)}</ul></li>)}</ol><a class="text-link more-link" href={url('/vision/')}>Read the full vision</a></div></section>
<section class="chapter journal-chapter" id="journal"><div class="container journal-layout"><div><p class="eyebrow">07 — NOTES FROM THE PROCESS</p><h2 class="display-xl">The creator's<br/><em>journal.</em></h2></div><div><p class="journal-topics">Engineering / Creativity / Projects / Personal growth</p><p class="lede">The next story is taking shape.</p><p>No articles published yet. Until then, explore the thinking and process behind the projects.</p><a class="text-link" href={url('/journal/')}>Open the journal</a></div></div></section>
<section class="chapter connect-chapter" id="connect"><div class="container"><p class="eyebrow">08 — LET'S CONNECT</p><h2 class="connect-title" data-reveal>Let's build<br/><em>what comes next.</em></h2><div class="connect-layout"><div><p class="lede">A role, a collaboration, or an idea that deserves to exist. I'd love to hear it.</p><div class="contact-intents">{['Career opportunities','Collaborations','Creative partnerships','General contact'].map(s=><a href={mailtoLink(s)}>{s} <span>↗</span></a>)}</div><div class="social-row"><a href={'mailto:'+contact.email}>Email</a><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a><a href={contact.instagram} target="_blank" rel="noopener">Instagram</a><a href={contact.github} target="_blank" rel="noopener">GitHub</a></div></div><BusinessCard/></div></div></section>
</Base>

