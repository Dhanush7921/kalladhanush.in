---
import { url } from '../../lib/url';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

const posts = (await getCollection('journal', ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Creator's Journal" description="Notes and stories from Kalla Dhanush on engineering, photography and video.">
  <PageHero
    title="Creator's Journal"
    lede="Notes from the workbench and behind the camera — process, lessons and stories behind the work."
  />
  <section class="chapter" aria-label="Articles">
    <div class="container">
      {posts.length > 0 ? (
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <a href={url(`/journal/${post.id}/`)}>
                <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
                <h2>{post.data.title}</h2>
                <p>{post.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p class="first">No entries yet.</p>
          <p class="muted">
            New articles land here as soon as they are published. Until then, the projects tell the story.
          </p>
          <div class="actions">
            <a class="btn btn-gold" href={url('/projects/')}>Read about the projects</a>
            <a class="btn" href={url('/world/')}>Explore my world</a>
          </div>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .posts a { display: grid; gap: 0.5rem; padding: 2rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .posts a:hover h2 { color: var(--gold-bright); }
  time { font-size: 0.85rem; color: var(--gold); }
  .posts h2 { font-size: var(--step-3); transition: color 0.3s; }
  .posts p { color: var(--ivory-dim); max-width: 60ch; margin: 0; }
  .empty { max-width: 44rem; padding: 2.5rem 0; border-top: 1px solid var(--line); }
  .first { font-family: var(--font-display); font-style: italic; font-size: var(--step-3); color: var(--gold-bright); margin-bottom: 1rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>

